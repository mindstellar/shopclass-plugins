    { "src": "https://raw.githubusercontent.com/mindstellar/shopclass-plugin-stripe/main/assets/screenshot-3.png", "caption": "Buyers pay on Stripe's own page; no card data touches the site" },
    { "src": "https://raw.githubusercontent.com/mindstellar/shopclass-plugin-stripe/main/assets/screenshot-4.png", "caption": "Refund from the order screen, or open the payment in Stripe" },
